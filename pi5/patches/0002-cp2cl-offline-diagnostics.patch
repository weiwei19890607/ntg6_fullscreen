+//! Read-only diagnostics: never touches GPIO, D-Bus, USB, or writable config.
+use anyhow::{Context, Result};
+use iap2_mfi::FileCoprocessor;
+use serde_json::json;
+use std::path::Path;
+
+pub fn check() -> Result<()> {
+    let cfg = crate::config::load();
+    let dir = Path::new(crate::config::DATA_DIR);
+    let key = dir.join("identity.pk8");
+    let cert = dir.join("certificate.p7b");
+    let credentials = match (key.exists(), cert.exists()) {
+        (false, false) => "absent",
+        (true, true) => {
+            FileCoprocessor::open(dir).context("MFi files cannot be parsed")?;
+            "parsed_unverified"
+        }
+        _ => anyhow::bail!("incomplete MFi credential pair"),
+    };
+    println!("{}", serde_json::to_string_pretty(&json!({
+        "mode": "read_only_check", "version": env!("CP2CL_VERSION"),
+        "commit": env!("CP2CL_COMMIT"), "config": crate::config::json(&cfg),
+        "mfi": credentials, "carlife_key_embedded": option_env!("CARLIFE_PRIVATE_KEY").is_some_and(|s| !s.trim().is_empty()),
+        "configfs_present": Path::new("/sys/kernel/config/usb_gadget").is_dir(),
+        "udc": std::fs::read_dir("/sys/class/udc").map(|r| r.flatten().map(|e| e.file_name().to_string_lossy().into_owned()).collect::<Vec<_>>()).unwrap_or_default(),
+        "real_carplay_verified": false
+    }))?);
+    Ok(())
+}
+
+/// No GPIO, Bluetooth, gadget, credentials, configuration writes or control APIs.
+pub async fn offline_web() -> Result<()> {
+    let status = std::sync::Arc::new(crate::web::Status::new(std::sync::Arc::new(carplay_hu::report::Report::new())));
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:18080").await?;
+    eprintln!("OFFLINE ONLY: http://127.0.0.1:18080 ; no CarPlay/CarLife devices connected");
+    crate::web::serve_read_only(listener, status).await?;
+    Ok(())
+}
diff --git a/src/web/system.rs b/src/web/system.rs
new file mode 100644
index 0000000..cc608a3
--- /dev/null
+++ b/src/web/system.rs
@@ -0,0 +1,132 @@
+//! Pi system controls, available only with the installed fixed mode helper.
+use axum::{body::Bytes, http::{HeaderMap, StatusCode}, response::Response};
+use serde_json::{json, Value};
+use std::{path::Path, sync::atomic::{AtomicBool, Ordering}, time::Duration};
+use tokio::process::Command;
+use super::json_answer;
+
+const MODE: &str = "/usr/local/sbin/cp2cl-mode";
+static PENDING: AtomicBool = AtomicBool::new(false);
+
+#[derive(Clone, Copy)]
+enum Action { Maintenance, Normal, Poweroff }
+impl Action {
+    fn mode(self) -> Option<&'static str> {
+        match self { Self::Maintenance => Some("maintenance"), Self::Normal => Some("protect"), Self::Poweroff => None }
+    }
+    fn power(self) -> &'static str { if matches!(self, Self::Poweroff) { "poweroff" } else { "reboot" } }
+}
+
+async fn command(program: &str, args: &[&str]) -> Result<Vec<u8>, String> {
+    let mut cmd = Command::new(program);
+    cmd.args(args).kill_on_drop(true);
+    let out = tokio::time::timeout(Duration::from_secs(10), cmd.output()).await
+        .map_err(|_| "设备操作超时".to_string())?.map_err(|e| e.to_string())?;
+    if !out.status.success() {
+        return Err(String::from_utf8_lossy(&out.stderr).trim().to_string());
+    }
+    Ok(out.stdout)
+}
+
+async fn read_status() -> Result<Value, String> {
+    let data = command(MODE, &["status"]).await?;
+    let mut value: Value = serde_json::from_slice(&data).map_err(|e| e.to_string())?;
+    value["supported"] = json!(true);
+    value["pending"] = json!(PENDING.load(Ordering::SeqCst));
+    value["boot_id"] = json!(std::fs::read_to_string("/proc/sys/kernel/random/boot_id").unwrap_or_default().trim());
+    Ok(value)
+}
+
+pub async fn status() -> Response {
+    if !Path::new(MODE).is_file() { return offline().await; }
+    match read_status().await {
+        Ok(data) => json_answer(StatusCode::OK, data),
+        Err(error) => json_answer(StatusCode::SERVICE_UNAVAILABLE, json!({"error":error})),
+    }
+}
+
+pub async fn offline() -> Response {
+    json_answer(StatusCode::OK, json!({"supported":false,"current":"unavailable","next_boot":"unavailable"}))
+}
+
+// JSON plus explicit confirmation avoids accidental form submissions; reject foreign origins.
+fn confirmed(headers: &HeaderMap, body: &[u8]) -> Result<(), &'static str> {
+    let content = headers.get("content-type").and_then(|v| v.to_str().ok()).unwrap_or("");
+    if content.split(';').next().unwrap_or("").trim() != "application/json" { return Err("请使用 JSON 确认操作"); }
+    if let Some(origin) = headers.get("origin") {
+        let uri = origin.to_str().ok().and_then(|s| s.parse::<axum::http::Uri>().ok());
+        let host = headers.get("host").and_then(|v| v.to_str().ok());
+        if uri.as_ref().and_then(|u| u.authority()).map(|a| a.as_str()) != host || host.is_none()
+            || !matches!(uri.as_ref().and_then(|u| u.scheme_str()), Some("http" | "https")) {
+            return Err("请从本机管理页面执行操作");
+        }
+    }
+    let value: Value = serde_json::from_slice(body).map_err(|_| "无效的操作确认")?;
+    if value.get("confirm").and_then(Value::as_bool) != Some(true) { return Err("操作尚未确认"); }
+    Ok(())
+}
+
+async fn act(action: Action, headers: HeaderMap, body: Bytes) -> Response {
+    if let Err(error) = confirmed(&headers, &body) {
+        return json_answer(StatusCode::BAD_REQUEST, json!({"error":error}));
+    }
+    if !Path::new(MODE).is_file() {
+        return json_answer(StatusCode::SERVICE_UNAVAILABLE, json!({"error":"此设备未安装模式管理工具"}));
+    }
+    if PENDING.compare_exchange(false, true, Ordering::SeqCst, Ordering::SeqCst).is_err() {
+        return json_answer(StatusCode::CONFLICT, json!({"error":"设备操作已在进行，请稍候"}));
+    }
+    let result: Result<(), String> = async {
+        if let Some(mode) = action.mode() {
+            let current = read_status().await?;
+            let desired = if mode == "protect" { "protected" } else { "maintenance" };
+            if current["current"].as_str() == Some(desired) && current["next_boot"].as_str() == Some(desired) {
+                return Err("当前已经是所选模式".into());
+            }
+            command(MODE, &[mode]).await?;
+        }
+        // systemd owns the delayed job; it remains valid when cp2cl stops during shutdown.
+        command("/usr/bin/systemd-run", &["--unit=cp2cl-web-power", "--on-active=3s", "--collect",
+            "/usr/bin/systemctl", action.power()]).await?;
+        Ok(())
+    }.await;
+    match result {
+        Ok(()) => {
+            tracing::info!("web.system_action power={} mode={:?}", action.power(), action.mode());
+            json_answer(StatusCode::OK, json!({"ok":true,"action":action.power(),"delay_seconds":3}))
+        }
+        Err(error) => {
+            PENDING.store(false, Ordering::SeqCst);
+            tracing::warn!("web.system_action_failed err={error}");
+            json_answer(StatusCode::INTERNAL_SERVER_ERROR, json!({"error":error}))
+        }
+    }
+}
+
+pub async fn maintenance(headers: HeaderMap, body: Bytes) -> Response { act(Action::Maintenance, headers, body).await }
+pub async fn normal(headers: HeaderMap, body: Bytes) -> Response { act(Action::Normal, headers, body).await }
+pub async fn poweroff(headers: HeaderMap, body: Bytes) -> Response { act(Action::Poweroff, headers, body).await }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn power_requires_explicit_json_confirmation_from_same_origin() {
+        let mut h = HeaderMap::new();
+        assert!(confirmed(&h, br#"{"confirm":true}"#).is_err());
+        h.insert("content-type", "application/json".parse().unwrap());
+        assert!(confirmed(&h, br#"{"confirm":false}"#).is_err());
+        assert!(confirmed(&h, br#"{}"#).is_err());
+        h.insert("host", "192.168.4.1".parse().unwrap());
+        h.insert("origin", "http://foreign.example".parse().unwrap());
+        assert!(confirmed(&h, br#"{"confirm":true}"#).is_err());
+        h.insert("origin", "http://192.168.4.1".parse().unwrap());
+        assert!(confirmed(&h, br#"{"confirm":true}"#).is_ok());
+    }
+    #[tokio::test]
+    async fn unconfirmed_power_request_is_rejected_without_scheduling() {
+        let result = poweroff(HeaderMap::new(), Bytes::from_static(b"{}")).await;
+        assert_eq!(result.status(), StatusCode::BAD_REQUEST);
+        assert!(!PENDING.load(Ordering::SeqCst));
+    }

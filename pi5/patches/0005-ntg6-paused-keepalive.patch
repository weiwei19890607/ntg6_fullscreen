+    /// NTG6 must keep the same session alive while showing its own desktop.
+    #[tokio::test]
+    async fn ntg6_pause_keeps_heartbeats_and_repeated_resume_uses_the_same_session() {
+        let (device, pipe) = tokio::io::duplex(64 * 1024);
+        let status = Arc::new(Report::new());
+        let observed = status.clone();
+        let car = tokio::spawn(async move {
+            let mut car = Car { pipe };
+            car.handshake_on("20062105", asked(), asked()).await;
+            car.start_the_encoder().await;
+            for _ in 0..3 {
+                car.send(HU_VIDEO_ENCODER_PAUSE, &[]).await;
+                let first = tokio::time::timeout(
+                    Duration::from_millis(500), car.expect(VIDEO_HEARTBEAT)
+                ).await;
+                assert!(first.is_ok(), "paused NTG6 still needs a video heartbeat");
+                let second = tokio::time::timeout(
+                    Duration::from_millis(500), car.expect(VIDEO_HEARTBEAT)
+                ).await;
+                assert!(second.is_ok(), "paused keepalive must continue");
+                assert_eq!(observed.json(serde_json::Value::Null)["encoding"], false);
+                assert_eq!(observed.json(serde_json::Value::Null)["session_up"], true);
+                car.start_the_encoder().await;
+                assert_eq!(observed.json(serde_json::Value::Null)["encoding"], true);
+            }
+        });
+        let watched = Watched::default();
+        let ports = ports(quiet(), &watched, home(), status, no_location());
+        run(device, &Machine::default(), None, &ports).await.unwrap();
+        car.await.unwrap();
+        assert_eq!(*watched.sessions.lock().unwrap(), vec![true, false]);
+    }

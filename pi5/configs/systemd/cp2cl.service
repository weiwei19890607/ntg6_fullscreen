[Unit]
Description=CarPlay to CarLife bridge on Raspberry Pi 5
Requires=cp2cl-usb.service cp2cl-ap.service cp2cl-dhcp.service bluetooth.service
PartOf=cp2cl-ap.service cp2cl-dhcp.service bluetooth.service
After=cp2cl-usb.service cp2cl-ap.service cp2cl-dhcp.service bluetooth.service
StartLimitIntervalSec=0
[Service]
Type=simple
User=root
UMask=0077
ExecStart=/opt/cp2cl/current/cp2cl
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
LimitCORE=0
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30
LogRateLimitBurst=1000
[Install]
WantedBy=multi-user.target
